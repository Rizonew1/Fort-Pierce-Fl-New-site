/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src https://www.googletagmanager.com 'sha256-1BTIBFCMGhaiHI9tIfWQ7RgPCa7ATehPmSWXp7fw6Cs='; connect-src https://www.google-analytics.com https://analytics.google.com https://www.googletagmanager.com; frame-src https://maps.google.com https://www.google.com; form-action 'self' mailto: https:; base-uri 'self'; frame-ancestors 'none'; object-src 'none'
  Link: </assets/fonts/archivo-narrow-700.woff2>; rel=preload; as=font; type=font/woff2; crossorigin

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/sitemap.xml
  Cache-Control: public, max-age=3600

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/thank-you/*
  X-Robots-Tag: noindex
